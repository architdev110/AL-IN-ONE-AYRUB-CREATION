# Frontend Environment Variables
REACT_APP_API_URL=http://localhost:5000/api
REACT_APP_ENV=development
REACT_APP_STRIPE_PUBLIC_KEY=your_stripe_public_key_here
REACT_APP_RAZORPAY_KEY_ID=your_razorpay_key_id_here

# Backend Environment Variables
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/ayrub
MONGODB_USER=root
MONGODB_PASSWORD=password

# JWT Tokens
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_12345
JWT_EXPIRE=7d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_change_this_in_production_67890
REFRESH_TOKEN_EXPIRE=30d

# Razorpay (India Payment Gateway)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Stripe (Global Payment Gateway)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_public_key

# Email Configuration (Optional)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=noreply@ayrub.com

# Admin Configuration
ADMIN_EMAIL=admin@ayrub.com
ADMIN_PASSWORD=change_this_secure_password

# File Upload
MAX_FILE_SIZE=52428800
UPLOAD_DIR=./uploads

# API Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug
LOG_FILE=./logs/app.log

# Application
APP_NAME=AYRUB
APP_VERSION=1.0.0
APP_URL=http://localhost:3000

# Session
SESSION_SECRET=your_session_secret_key_here
SESSION_TIMEOUT=24h

# Security
BCRYPT_ROUNDS=10
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME=15m

# QR Code Payment
QR_CODE_PAYMENT_ENABLED=true
QR_CODE_VERIFICATION_TIMEOUT=3600

# Feature Flags
ENABLE_EMAIL_VERIFICATION=false
ENABLE_TWO_FACTOR_AUTH=false
ENABLE_SOCIAL_LOGIN=false
